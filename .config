; IMPORTANT: Unlike other RMS files, the '.config' file is never automatically
; updated. When changes are introduced to the config file in RMS, these changes
; will NOT be automatically reflected in the active '.config' file on 
; individual machines. Users should manually update their '.config' file if 
; changing any option from its default value is desired, or to simply stay 
; up-to-date. If an option is missing from the config file, a default value 
; will be automatically applied.
; An up-to-date template config '.configTemplate' file, containing the current
; options, is located in the RMS root directory.
; Run python -m Utils.AuditConfig to compare the .config file to the template. 

[System]

; The assigned station ID
stationID: XX0001

; WGS84 +N (degrees)
latitude: 43.19301

; WGS84 +E (degrees)
longitude: -81.315555

; Mean sea level EGM96 geoidal datum, not WGS84 ellipsoidal (meters)
; Can be obtained from Google Earth or other apps. Raw GPS altitude should not
; be used as the software converts from EGM96 to WGS84 internally.
elevation: 327

; Should be set only if full CAMS compatibility is desired
cams_code: 0

; Weblog and PerfMonitor
; ----------------------

; Show this camera on the GMN weblog
weblog_enable: true

; The description shown on the weblog (e.g. location, pointing direction)
weblog_description: none

; Server will generate obfuscated coordinates for public datasets.
; Optionally, uncomment and populate the three parameters below to use a
; specific public location if desired. The recommended precision is two decimal
; places for latitude and longitude, and ~10 m for elevation.
;
; WGS84 +N (degrees)
; public_latitude: 0.0
;
; WGS84 +E (degrees)
; public_longitude: 0.0
;
; mean sea level EGM96 (meters)
; public_elevation: 0.0

; Camera network (e.g. national networks, used for grouping on the weblog).
; Separate by comma for multiple networks
network_name: none

; Camera group (e.g. a camera cluster or a location with multiple cameras)
camera_group_name: none

; Timeserver to use for ObservationSummary - leave blank or omit to use default 'time.cloudflare.com'
time_server:

; External script
; ---------------

; Enable running an external script at the end of every night. it will be passed
; three arguments: captured_night_dir, archived_night_dir, config 
external_script_run: false

; Toggle logging of the external script. If true, logging  will be captured by RMS from the external script. 
; If false, the script process will have all log handlers removed to prevent interference with its own logging.
external_script_log: false


; Run the external script after auto reprocess.
; "auto_reprocess" needs to be "true" for this to work.
auto_reprocess_external_script_run: false

; Full path to the external script
external_script_path: none

; Name of the function in the external script to be called
external_function_name: rmsExternal

; Daily reboot
; ---------------

; Reboot the computer daily after processing and upload
reboot_after_processing: true

; Lock file name for preventing rebooting until the script is done.
; The external script should remove this file if the reboot is to run after the
; script finishes. This file should be created in the config.data_dir directory
; (i.e. ~/RMS_data).
reboot_lock_file: .reboot_lock

[Capture]

; device URL
device: rtsp://192.168.42.10:554/user=admin&password=&channel=1&stream=0.sdp

; Transport Layer Protocol: 'tcp' or 'udp'. Defaults to tcp. UDP typically
; provides more stable connectivity, but TCP has a longer track record.
protocol: tcp

; Per-socket UDP receive buffer size in bytes for the gst backend (rtspsrc).
; Larger values give RTP bursts more room and prevent UDP RcvbufErrors ->
; dropped frames. Requires net.core.rmem_max >= this value (run
; Scripts/UpdateBuffers.sh) or the kernel clamps it back. Default is 16 MB.
udp_buffer_size: 16777216

; Media Backend: options are gst, cv2, or v4l2.
; 'gst':    (default - preferred) GStreamer Standalone. Bypass OpenCV, and
;           provides the highest timestamps accuracy.
; 'cv2':    OpenCV method. Reliable but has poor timestamping performance. 
; 'v4l2':   OpenCV with v4l2, uses v4l2 hardware acceleration with OpenCV.
; If gst, or v4l2 return an error, the code reverts to cv2.
media_backend: gst

; Gstreamer color space to use. Only applicable if media_backend is gst.
; Examples: BGR, GRAY8
gst_colorspace: BGR

; Gstreamer decoder element to use. Only applicable if media_backend is gst.
; Examples: decodebin, avdec_h264, nvh264dec
gst_decoder: avdec_h264

; Max decoded frames buffered per GStreamer queue element. Higher values absorb
; processing spikes without dropping frames. On memory-constrained systems this
; can trigger a swap death spiral. Reduce if experiencing OOM even after reducing
; num_cores to 1.
gst_queue_size: 100

; Path to the camera settings json
; e.g. ~/username/source/Stations/XX0001/camera_settings.json
; or   ./camera_settings.json
camera_settings_path: ./camera_settings.json

; Run the one-time camera setup defined in camera_settings.json.
; If no "XX0001.camera_init_done" flag file exists in the RMS root dir,
; the commands in the "init" section are sent to the camera.  After a
; successful run, the flag file is created so future launches skip the
; initialization step. Remove flag to perform initialization again. 
initialize_camera: false

uyvy_pixelformat: false

; If we do not want to process full resolution video, we can scale it for the purpose of processing.
; In such cases, the original raw video will still be saved in full resolution (if raw_video_save is true).
; Optional parameters but both values need to be set for scaling to work. If only one is set, no scaling will be applied.
; NOTE: scaling and cropping below are only applied on the GStreamer (gst) media backend; other
; backends ignore them.
; IMPORTANT: the width/height settings further down must equal the final scaled-and-cropped frame
; size. Scaling is applied first, then cropping: final_width = video_scale_width - left - right and
; final_height = video_scale_height - top - bottom. If width/height do not match, a smaller frame is
; silently zero-padded into the top-left and a larger frame aborts the capture (a warning is logged).
; video_scale_width: 1280
; video_scale_height: 720

; If we want to limit size of original video (instead or in addition to scaling), we can crop the video.
; The format is "top=X bottom=X left=X right=X", where X is the number of pixels to crop from each side. e.g.:
; video_crop: top=10 bottom=20 left=15 right=15
; Optional parameter. If left empty or set to "none", no cropping will be applied.
; video_crop: none

; The capture device resolution
width: 1280
height: 720

; Region of interest. -1 to disable
roi_left: -1
roi_right: -1
roi_up: -1
roi_down: -1

; Bit depth of the camera (e.g. an 8-bit camera)
bit_depth: 8

; Gamma of the camera. Usually 0.45 or 1.0
gamma: 1.0


; Frames per second (FPS) are precisely calculated and reported at the end of
; each capture session when in GStreamer standalone mode. This information can
; be found in each session's log by searching for 'Last Calculated FPS'. Please
; update the value here with the log's reported value. The calculate FPS
; often differs from the nominal FPS, usually by less than 0.1%.
; Example: fps: 24.98122
fps: 25.0

; Camera Latency Settings for GStreamer Timestamps
; ------------------------------------------------
; The following two parameters correct for camera latency when in GStreamer
; Standalone mode. The settings are ignored when using other media_backend
; methods.
; The settings should be experimentally establishes for the specific setup.
; For example:  RPi4, IMX291, 720p @ 25 FPS, VBR
;               camera_buffer: 1
;               camera_latency: 0.05
; If timestamps are late, increase latency. If early, decrease latency.
; Formula is:
; corrected_timestamp = timestamp - camera_buffer / fps - total_latency
; camera_buffer corresponds to the number of frames in the camera's internal
; buffer. If these parameters are not present then RMS will use the default. 

; frames (integer). Default is 1
camera_buffer: 1

; delay in seconds. Default is 0.05 s (50 ms)
camera_latency: 0.05

; Point of the exposure of every frame at which the frames of frame block (.fblk) files are timed: start,
; middle or end. The blocks record the time of the start of the integration of every frame and its exposure;
; the position of a moving object measured on a frame is its position at the middle of the exposure, so
; middle gives times which match the positions. Default is middle
frame_block_time: middle

; Log dropped frames. Only reliable for analog cameras
report_dropped_frames: false


; Deinterlacing:    -2 = global shutter
;                   -1 = rolling shutter
;                    0 = even first
;                    1 = odd first
deinterlace_order: -1

; Rolling shutter (deinterlace_order: -1): the measured time in seconds in which the sensor reads all its rows,
; from the top of the image to the bottom. The time of a point on the image is corrected by its row: frame time +
; readout*row/rows. The readout time depends on the sensor and its mode, e.g. a 1080p sensor which reads its rows
; in 0.032 s while recording at 10 fps (0.1 s per frame); it is the row time of the sensor mode times the number of
; rows, or measured against another camera with a global shutter. 0 makes no correction. It is the time for all
; rows of the sensor: rows removed by video_crop and the region of interest are taken into account
rolling_shutter_readout: 0

; Correction of the timestamps of the frames in seconds, added when the frames of a recording are read for
; processing: the true time of a frame is its timestamp + frame_time_offset (e.g. 0.084 for a recording system
; which stamps its frames 84 ms before the middle of their exposure). It is measured, e.g. against objects with
; precisely known positions or against another camera on the same objects. It applies to the recordings whose
; frame times RMS reads (.vid files, frame blocks, directories of images and FITS files, video files, DFN images),
; not to FF files, whose times are their names: those are corrected when they are recorded (camera_latency).
; 0 makes no correction
frame_time_offset: 0


; Approximate Field-of-view in degrees
fov_w: 87
fov_h: 45

; Format of files, either 'bin' (CAMS format), or 'fits' (new RMS format)
ff_format: fits


; Toggle saving of frame time files (FT files) to times_dir
save_frame_times: true

; Toggle saving video frames at a set interval to the frame_dir
save_frames: true

; Set whether to delete, archive, or leave saved frames after making timelapse
; Options are: delete , tar, or none
frame_cleanup: delete

; The file extension for saved frames ('jpg' or 'png')
frame_file_type: jpg

; Set the saved framed JPEG quality for jpg file type [0-100]
jpgs_quality: 90

; Set the saved framed PNG compression for png file type [0-9]
png_compression: 3

; Run capture continuously, through day/night
continuous_capture: false

; Switch camera settings between day/night modes if continuous_capture is on
; using the settings in camera_settings.json "day" and "night" sections.
switch_camera_modes: false

; Toggle raw video saving in data_dir/video_dir
raw_video_save: false

; Duration of the raw video segment (seconds).
; If -1, the segment duration will be 256/FPS seconds
raw_video_duration: 30

; Path to the directory where all data will be stored
data_dir: ~/RMS_data

; Name of directory within data_dir for raw captured files
captured_dir: CapturedFiles

; Name of directory within data_dir for archived files
archived_dir: ArchivedFiles

; Name of directory within data_dir for saved frame files
frame_dir: FramesFiles

; Name of directory within data_dir for raw video files
video_dir: VideoFiles

; Name of directory within data_dir for timestamp (FT) files
times_dir: TimeFiles

; Name of directory within data_dir for log files
log_dir: logs

; Extra GB space left on the SD card nightly, accounting for the predicted
; size of all FF files.
extra_space_gb: 5

; By default the system will keep 20 ArchivedFiles folders and compressed
; versions of the folders. You can adjust these limits using the below
; parameters. A value of zero means do nothing ie keep everything forever.

; Number of ArchivedFiles folders to keep. Default is 20
arch_dirs_to_keep: 20

; Number of days of logs to keep. Default is 30.
; If set to 0, logs will not be deleted.
logdays_to_keep: 30

; Set the console log level. Options are:
; 0 - no logging (CRITICAL)
; 1 - error messages only (ERROR)
; 2 - error and warning messages (WARNING)
; 3 - error, warning, and info messages (INFO)
; 4 - error, warning, info, and debug messages (DEBUG)
console_log_level: 3

; Control additional logging of console output messages
; Set to true to include extra console output in log file
; Note: This does not affect normal logging, only additional console messages
log_stdout: false

; Number of bz2 compressed archive folders to keep. Default 20
bz2_files_to_keep: 20

; Number of CapturedFiles folders to keep. Default is 8
capt_dirs_to_keep: 8

; Number of frame file days to keep. Default is 4
frame_days_to_keep: 4

; Number of raw video folders (days) to keep. Default is 2
video_days_to_keep: 2

; Number of ft file (timestamp) folders (days) to keep. Default is 8
times_days_to_keep: 8


; the next settings configure the archive management by space used on disk
quota_management_enabled: false

; Any one of the next five parameters missing or commented out disables
; the quota management.
; Each of the parameters is in GB.

; Overall space allowance for the data directory, typically RMS_data
rms_data_quota: 4000

; Space allowance for the archived directories, and files contained within
arch_dir_quota: 100

; Space allowance for log files
log_files_quota: 0.1

; Space allowance for the bz2 files
bz2_files_quota: 100

; Space allowance for continuous capture
continuous_capture_quota: 30

; Therefore the space allowed for the CapturedFiles directory is
; rms_data_quota - (arch_dir_quota + bz2_files_quota + log_files_quota + continuous_capture_quota)
; space used by .db files is ignored


; Toggle showing maxpixel on the screen during capture
live_maxpixel_enable: false

; Toggle saving a single jpg with the latest maxpixel image in the data dir
live_jpg: false


; Toggle daytime slideshow of last night's meteor detections
slideshow_enable: false

; Auto-reprocess broken capture directories after power cuts or crashes
auto_reprocess: true

; Give up on a capture directory after this many failed auto-reprocess attempts, so a night which
; fails every time does not eat the pre-capture window on every start. Set to 0 to retry forever
auto_reprocess_max_attempts: 3

; Also reprocess nights which look processed but have no directory in ArchivedFiles. Leave this off
; unless you know you need it: retention (arch_dirs_to_keep, capt_dirs_to_keep) and quota management
; delete ArchivedFiles independently of CapturedFiles, so on a space-constrained station a missing
; archive usually means it was purged, not that the night was never processed. With this enabled
; such nights are reprocessed once each, up to auto_reprocess_max_attempts
reprocess_if_archive_missing: false

; Flag file to load processed files on capture resume
capture_resume_flag_file: .capture_resuming

; Additional wait time (seconds) for staggered start in multi-camera setups
capture_wait_seconds: 0

; Randomize wait time (0 to capture_wait_seconds) for multi-camera systems.
capture_wait_randomize: false

; Process detection and postprocessing at night's end, not during capture.
postprocess_at_end: false

; Add extra seconds before starting detection: after capture begins if
; postprocess_at_end is false, or after capture ends if true.
postprocess_delay: 0


[Build]

; Compiler arguments for cython
rpi_weave: -O3 -mfpu=neon -funsafe-loop-optimizations -ftree-loop-if-convert-stores
linux_pc_weave: -O3
win_pc_weave:



[Upload]

; Flag for enabling/disabling upload to meteor server
upload_enabled: true

; If upload_split is true, two archives will be created.
; One archive, suffix _imgdata, contains the images. The
; other archive, suffix _metadata will only contain the
; data derived from the images, including the timelapse.
;
; The metadata archive is much smaller than the imagedata
; archive, and can be extracted very quickly. This speeds up the
; processing on the server, since the image data is generally not
; required.

; If upload_split is false a single archive will be uploaded
; with the suffix _detected containing all images, and data derived.
; These archives are large and slow down the server side processing.

upload_split: true

; Delay upload for the given number of minutes
upload_delay: 0

; Server address
hostname: gmn.uwo.ca

; Standard SSH port
host_port: 22

; Path to the SSH private key
rsa_private_key: ~/.ssh/id_rsa

; Directory on the server where the detected files will be uploaded to
remote_dir: files

; Name of the file where the upload queue will be stored
upload_queue_file: FILES_TO_UPLOAD.inf

; Upload mode
; -----------
; By default, RMS will upload text files with meteor and star detections,
; secondary data products such as calibration plots, all FF image files, and all
; FR files with raw fireball frames. This typically results in an archive of
; 100-500 MB in size. Some stations have limited data or bad internet
; connections, so a reduced data set can be uploaded to the server.
; Options:
; 1 - Normal mode. Everything is uploaded, including FF files with detections.
; 2 - Skip FFs. Everything except two FF files will be uploaded. One with the
;     most matched stars and another random one with a meteor detection.
; 3 - Skip FFs and FRs. Same as option 2, but FR files will also be skipped.
; 4 - Skip FRs, but upload everything else.
upload_mode: 1

; Event Monitor
; -------------
; Upload events on demand
event_monitor_enabled: true

; Webpage for watchlist
event_monitor_webpage: https://globalmeteornetwork.org/events/event_watchlist.txt

; Where to put the detected events
event_monitor_remote_dir: files/event_monitor

; Remote server will be as given in hostname

; Event monitor check interval (minutes)
event_monitor_check_interval: 30
event_monitor_check_interval_fast: 3



[Compression]



[FireballDetection]

; Flag for enabling/disabling fireball detection
enable_fireball_detection: true

; Subsample to 16x16 squares (default 16)
subsampling_size: 16

; Weight for stddev in thresholding for fireball extraction
k1: 7.0

; Absolute offset in thresholding for fireball extraction
j1: 10

; Max runtime (seconds) for the line finding algorithm.
max_time: 6

; Threshold average frame level beyond which images are considered too white to
; process
white_avg_level: 220

; Absolute minimum brightness in order to consider a pixel (0-255)
minimal_level: 40

; How many pixels in a square to consider it as an event point (DEFAULT 8)
minimum_pixels: 8

; Absolute number of points per frame required for flare detection
max_points_per_frame: 30

; Multiplied with median number of points, used for flare detection
max_per_frame_factor: 10

; If there is more event points than this threshold, randomize them
max_points: 500

; Minimum number of frames covered by event points (not just one line, but all
; points)
min_frames: 6

; Minimum number of event points in a line
min_points: 8

; Percent of frames to extrapolate before a meteor trail's detected start
extend_before: 0.15

; Percent of frames to extrapolate after a meteor trail's detected end
extend_after: 0.15

; Absolute minimum size for extracted frame crop
min_window_size: 100

; Absolute maximum size for extracted frame crop
max_window_size: 400

; Threshold for dynamically determining window size
threshold_for_size: 0.9

; Max distance for a point to be considered part of the same line
distance_threshold: 70

; Maximum allowed gap between points
gap_threshold: 150

; Minimum frame range a line must span to exclude flash detections
line_minimum_frame_range: 6

; Constant affecting average point distance's impact on line quality.
line_distance_const: 4

; Ratio of points near a line needed before seeking another line.
point_ratio_threshold: 0.7

; Maximum number of lines which are allowed to be found on the image
max_lines: 5



[MeteorDetection]

; Minimum number of stars required in order to run the detection
ff_min_stars: 20 

; Binning (only supported for videos, images, and vid files, but no FF files!)
; -------
; Bin images before detection (has to be a factor of 2, e.g. 2, 4, 8, etc.).
; The X, Y coordinates in detections will be rescaled to the original size.
; 1 = do not bin.
detection_binning_factor: 1 

; The image can be binned by either averaging ('avg') or summing ('sum') pixel
; intensities in the bin window. Note that the output image data type is uint16,
; so be careful of integer overflows when using "sum" method!
detection_binning_method: avg

; Thresholding and KHT parameters
; -------------------------------

; Weight for stddev in thresholding for faint meteor detection
k1: 3.5

; Absolute levels above average in thresholding for faint meteor detection 
j1: 12

; Number of frames in the reservoir sampling buffer used for avepixel and stdpixel estimation.
; Default is 64. Higher values (e.g. 256) provide better precision but increase memory and CPU time linearly
; (approx 4x performance hit for 256 frames). Larger sampling buffer = less thresholding noise.
background_reservoir_size: 64

; Number of threads which compute the background (median) and the noise of every frame chunk, 0 for all CPU cores.
; More threads help when the computer has more CPU cores than cameras, e.g. for large frames. Default 1.
median_threads: 1

; Maximum ratio of white to all pixels on a thresholded image
; (used to avoid searching on very messed up images)
max_white_ratio: 0.05

; Size of the time window which will be slided over the time axis
time_window_size: 64

; Subdivision size of the time axis
; (256 will be divided into 256/time_slide parts)
time_slide: 32


; Morphological operations to prepare the image for KHT
; 1 - clean (Remove lonely pixels)
; 2 - bridge (Connect close pixels)
; 3 - close (Close surrounded pixels)
; 4 - thin (Thin all lines to 1px width)
; Format: comma separated list of operation IDs
kht_morph_ops: 1, 2, 3, 4, 1


; Maximum number of lines to be found on the time segment with KHT
max_lines_det: 30

; Minimum Frechet distance to merge KHT lines in Cartesian space
; (used for merging similar lines after KHT)
line_min_dist: 50

; Stripe width around the line for centroiding and photometry
stripe_width: 28



; Line finder algorithm: 'kht' or 'ransac'
line_finder_algorithm: kht

; =============================================================================
; Sequential RANSAC 2D line finder parameters
; =============================================================================

; Maximum number of 2D line candidates to extract from each projected time
; segment. Increasing this may recover more overlapping/fragmented tracks, but
; increases runtime and false candidates.
ransac_max_lines: 10

; Minimum number of threshold pixels required for a 2D RANSAC line candidate.
; Increase to reject small noise groups; decrease to allow shorter/fainter lines.
ransac_min_pixels: 10

; Maximum perpendicular distance of a threshold pixel from a 2D RANSAC line to
; be counted as an inlier (pixels). Larger values tolerate broader/noisier
; streaks but can absorb nearby clutter.
ransac_distance_thresh: 4.0

; Minimum accepted 2D line length (pixels). Shorter candidates are discarded.
ransac_min_line_length: 20.0

; Maximum gap between neighbouring inlier pixels along a 2D RANSAC line (pixels).
; Larger values allow broken threshold masks; smaller values reject fragmented
; or noisy line candidates.
ransac_max_gap: 20.0

; Maximum frame gap allowed when validating the temporal continuity of detections
; produced by the sequential 2D RANSAC path (frames).
ransac_max_gap_frame_det: 30.0

; Maximum spatial gap allowed when validating detections produced by the
; sequential 2D RANSAC path (pixels).
ransac_max_gap_spatial_det: 50.0

; =============================================================================
; RANSAC 3D line finder parameters
; =============================================================================

; Maximum number of 3D (x, y, frame) line candidates to extract from the
; thresholded point cloud. Increasing this may recover multiple nearby tracks,
; but increases runtime and duplicate candidates.
ransac3d_max_lines: 5

; Minimum number of threshold points required for a valid 3D RANSAC line.
; Increase to reject sparse noise; decrease to allow short/faint tracks.
ransac3d_min_points: 10

; Maximum distance of a point from the 3D line to be considered an inlier.
; The frame axis is internally scaled to image pixels. Larger values tolerate
; curvature/measurement scatter but can merge nearby unrelated pixels.
ransac3d_distance_thresh: 4.0

; Maximum frame gap between neighbouring inlier points on a 3D line (frames).
; Larger values allow temporarily missing threshold pixels; smaller values
; reject tracks with large temporal holes.
ransac3d_max_gap_frame: 30.0

; Maximum spatial gap between neighbouring inlier points on a 3D line (pixels).
; Larger values allow broken spatial masks; smaller values reject discontinuous
; or falsely stitched tracks.
ransac3d_max_gap_spatial: 50.0

; Minimum frame span required for a valid 3D line (frames). This rejects flashes
; and very short detections that do not show sustained motion.
ransac3d_min_frames: 4.0

; Number of random line hypotheses tested per 3D RANSAC search pass. Increasing
; this improves the chance of finding the best line in dense/noisy point clouds,
; but increases runtime. With 10, long tracks are often found in pieces.
ransac3d_iterations: 100

; Maximum 3D distance between a candidate line fragment and the seed line when
; stitching fragments with similar directions (pixels). Larger values merge
; more broken pieces; smaller values avoid merging nearby independent tracks.
ransac3d_stitch_dist_thresh: 5.0




; =============================================================================
; KHT line finder parameters
; Please do not touch these values unless you know what you are doing.
; =============================================================================

; Minimum number of pixels required to form a valid cluster.
; Increasing this value reduces noise (fewer spurious small lines) but might cause you to miss short, valid line segments.
kht_cluster_min_size: 9

; Minimum width (spread) of the Gaussian kernel perpendicular to the line.
; A higher value makes the voting more tolerant to slight misalignments but reduces precision.
kht_cluster_min_deviation: 2

; Discretization step size for the parameter space (angle).
; A smaller delta gives higher angular precision but increases the size of the accumulator array and computation time.
kht_delta: 0.1

; Minimum peak height for a Gaussian kernel to be cast into the accumulator.
; Increasing this filters out "weak" or noisy lines. Decreasing it allows more uncertain clusters to vote.
kht_kernel_min_height: 0.004

; Number of standard deviations (sigma) used to define the extent of the Gaussian kernel.
; A value of 1 makes the algorithm much faster (fewer bins to update per cluster) but might miss votes if the alignment isn't perfect.
kht_n_sigmas: 1

; =============================================================================
; Legacy 3D matched-filter line finder parameters
; =============================================================================

; Maximum number of points during 3D line search in faint meteor detection
; (used to minimize runtime)
max_points_det: 500

; Maximum distance between the line and the point to be taken as a part of the
; same line, rescaled to 720x576 (if > 20, it will be divided by
; subsampling_size^2 to preserve compatibility with older config files)
distance_threshold_det: 5

; Maximum allowed gap between points in pixels, rescaled to 720x576 (if > 100,
; it will be divided by subsampling_size^2 to preserve compatibility with older
; config files)
gap_threshold_det: 50

; Minimum number of pixels in a strip
min_pixels_det: 10

; Minimum number of frames per one detection
line_minimum_frame_range_det: 4

; Constant that determines the influence of average point distance on the line
; quality
line_distance_const_det: 4

; Maximum time in seconds for which line finding algorithm can run
max_time_det: 7

; =============================================================================
; Line postprocessing and centroid frame-range parameters
; =============================================================================

; Maximum direction angle difference for merging line fragments found in the
; same stripe (degrees). Larger values merge more aggressively; smaller values
; preserve separate nearby tracks.
vect_angle_thresh: 20

; Number of frames added before and after the initially detected frame range
; when extracting pixels for centroiding/photometry. Larger values can recover
; weak ends of a track; too large can include unrelated pixels.
frame_extension: 10

; =============================================================================
; Centroid mask and photometry aperture parameters
; =============================================================================

; Number of pixels by which the thresholded stripe mask is dilated for
; centroiding/photometry on video/image inputs. Larger values include more PSF
; wings and background; smaller values keep the mask tight.
centroid_dilation: 2

; =============================================================================
; Gaussian centroid refinement parameters
; =============================================================================

; Refine meteor centroid positions by fitting a bounded 2D Gaussian on a small
; cutout around the intensity-weighted centroid. If the fit fails, the weighted
; centroid is kept. Only active for non-deinterlaced inputs
; (deinterlace_order < 0).
centroid_gaussian_fit: false

; Gaussian centroid fitting method. Options:
;   rotated_lsq - rotated 2D Gaussian with eigendecomposition-seeded multi-start
;                 (best for standard video meteors)
;   axis_lsq    - axis-aligned 2D Gaussian, single least-squares solve (faster
;                 but less accurate on elongated streaks)
;   moving      - moving 2D Gaussian (Veres et al. 2012) integrated along the
;                 track direction (best for tracked slow objects)
;   kinematic   - moving 2D Gaussian with L fixed from the RANSAC angular velocity
;                 instead of fitted from pixel spread; tight L bounds [0.5*L, 1.5*L]
;                 and peak+5x5 init (best for fast global-shutter meteors)
; For 'moving' and 'kinematic': when line_speed < centroid_moving_gaussian_min_speed
; the method falls back to rotated_lsq (with moving_gaussian_fallback=True, suppressing
; peak+5x5 init).  When L_kinematic < centroid_moving_gaussian_sigma_init the method also
; falls back to rotated_lsq (L << sigma -> flat loss landscape, optimizer wanders).
centroid_gaussian_fit_method: moving

; Half-size of the square Gaussian fitting patch in pixels for static methods
; (rotated_lsq, axis_lsq). The patch spans roughly (2*radius + 1)^2 pixels.
; Larger patches include more streak/background; smaller patches are faster but
; may clip broad PSFs.
centroid_gaussian_fit_radius: 4

; Maximum allowed fitted-centroid shift from the initial centroid (pixels).
; Fits that shift farther than this are rejected and the weighted centroid is
; kept. Larger values allow larger corrections; smaller values are safer near
; stars or clutter.
centroid_gaussian_fit_max_shift: 2.5

; Maximum optimizer function evaluations per Gaussian fit/seed. Increase for
; difficult moving fits or dense frames; decrease to cap runtime.
centroid_gaussian_fit_max_nfev: 300

; Initial cross-track Gaussian sigma for the 'moving' method (pixels).
; Used as the starting sigma in the multi-seed optimisation; overridden per frame
; from stripe pixel moments when enough pixels are available. Also used as a
; minimum-speed fallback check for moving/kinematic fits.
centroid_moving_gaussian_sigma_init: 2.0

; Minimum RANSAC line speed (px/frame) for 'moving'/'kinematic' methods.  Detections
; slower than this fall back to rotated_lsq with peak+5x5 suppressed (near-stationary
; targets have undefined omega and avepixel cancels the peak-pixel signal).
; Set to 0.0 to disable (use moving Gaussian for all speeds).
centroid_moving_gaussian_min_speed: 0.2

; Outlier-rejection threshold for the 'moving' and 'kinematic' Gaussian centroid methods (pixels).
; After fitting, the result is compared to the per-frame weighted centroid (the Gaussian's own
; starting point).  If the Gaussian drifted farther than this value the fit likely landed on a
; spurious local minimum (background star, cosmic ray).  The fit is re-run with max_shift clamped
; to this threshold so the spurious minimum is excluded; if the retry also fails the frame falls
; back to the weighted centroid.  Set to 0.0 (default) to disable.
centroid_moving_gaussian_max_deviation: 0.0


; =============================================================================
; Curved centroid pixel selector parameters
; =============================================================================

; Use a fitted curved motion model to select centroiding pixels. This is a
; centroid-only refinement: RANSAC detection, detection filtering, and photometry
; stripe selection remain unchanged. Useful for tracked slow objects whose apparent 
; image motion is not well described by a straight (x, y, frame) line over the full track.
centroid_curve_refine: false

; Polynomial order of the centroid curve x(frame), y(frame). 2 is the default
; quadratic model; 1 is a straight-line model; higher values are usually not
; recommended unless the track is long and well sampled.
centroid_curve_order: 2

; Pixel radius around the fitted curve used to select centroiding pixels from
; the existing thresholded stripe pixels. Larger values include more candidate
; pixels; smaller values make the centroid mask tighter but can miss the target
; if the curve fit is imperfect.
centroid_curve_radius: 4.0

; Minimum number of frames with usable stripe peaks required to fit the curve.
; If fewer frames are available, centroiding falls back to the RANSAC line mask.
centroid_curve_min_frames: 8

; Robust sigma-clipping threshold for rejecting bad per-frame peak anchors before
; fitting the curve. Larger values reject fewer anchors; smaller values reject
; more aggressively. Set to 0.0 to disable clipping.
centroid_curve_clip_sigma: 3.0

; Maximum deviation of a centroid point from a LSQ fitted line
; (if above max, it will be rejected)
centroids_max_deviation: 2

; Maximum distance in pixels between centroids
; (used for filtering spurious centroids)
centroids_max_distance: 30

; Filter out centroids with large frame gaps at the edges
; Set to false to keep all centroids regardless of frame gaps
centroids_filter_frame_gaps: true

; Angular velocity filter (deg/s)
ang_vel_min: 2.0
ang_vel_max: 51.0

; Filtering by intensity
; By default the peak of the meteor should be at least 16x brighter than the
; background. This is the  multiplier that scales this number (1.0 = 16x).
; Disabled if the ML filter is turned on.
min_patch_intensity_multiplier: 0.0

; Detection filtering by machine learning. This was only optimized on moderate
; field of view images and IMX291 and IMX307 data. Disable by setting to -1.
; The recommended threshold is 0.85. This will disable
; the min_patch_intensity_multiplier filtering method.
ml_filter: 0.85

; Use the older model for ML filtering - file in share directory, default: hyper_model.tflite
; ml_model_file = meteorml32.tflite

; All detection this close (in pixels) to the edge of the image or the mask
; will be removed
detection_border: 5


; Hardware
; ------------

; Number of CPU cores to use for the detection.
; If set to <=0, (all cores + num_cores) will be used
num_cores: -1


[StarExtraction]

; Extract stars
; -------------

; Maximum mean intensity of an image before it is discarded as too bright
max_global_intensity: 140

; Apply a mask on the detections by removing all that are too close to the
; given image border (in pixels)
border: 15

; Size of the neighbourhood for the maximum search (in pixels)
neighborhood_size: 10

; A threshold for cutting the detections which are too faint (0-255)
intensity_threshold: 18

; An upper limit on number of stars before the PSF fitting
; (more than that would take too long to process)
max_stars: 800


; PSF fit and filtering
; ---------------------

; Radius (in pixels) of image segment around the detected star on which to
; perform the fit
segment_radius: 4

; Minimum ratio of 2D Gaussian sigma X and sigma Y to be taken as a stars
; (hot pixels are narrow, while stars are round)
roundness_threshold: 0.5

; Maximum ratio between 2 sigma of the star and the image segment area
max_feature_ratio: 0.8



[Calibration]

; True - use flat for calibration, false - do not use flat
use_flat: false

; Name of the flat field file
flat_file: flat.bmp

; Minimum number of FF images for making a flat
flat_min_imgs: 30


; Star catalog
; ------------

; Name of the folder where the star catalog are kept
star_catalog_path: Catalogs

; Catalog file name
; Options:
; - GMN_StarCatalog - GMN star catalog, up to 12.0 mag (DEFAULT)
; - BSC5 - Bright Star Catalog 5th edition
; - gaia_dr2_mag_11.5.npy - Gaia DR2 catalog, up to 11.5 mag
; - STARS9TH_VBVRI.txt - Sky2000 catalog, up to 9.0 mag
star_catalog_file: GMN_StarCatalog

; Ratio of B, V, R, I, G, BP, RP bands. 
; Only works with GMN_StarCatalog and STARS9TH_VBVRI.txt
; For GMN_StarCatalog:
; - B, V, R, I, GAIA G, BP, RP are available, the latter three are GAIA bands
; For STARS9TH_VBVRI.txt:
; - Only B, V, R, I are available (the rest are ignored).
; If they are all set to zero, V band will be used
;                            B,   V,   R,   I,   G,  BP,  RP
star_catalog_band_ratios: 0.00,0.00,0.00,0.00,1.00,0.00,0.00


; Platepar and mask
; -----------------

; Name of the JSON file with recalibrated platepars for constant intervals of FF
; files
platepars_flux_recalibrated_name: platepars_flux_recalibrated.json

; Name of the JSON file with recalibrated platepars for every FF file
platepars_recalibrated_name: platepars_all_recalibrated.json

; Name of the new platepar file on the server
platepar_remote_name: platepar_latest.cal

; Name of the directory on the server which contains platepars
remote_platepar_dir: platepars

; Model of a platepar fitted from scratch by AutoPlatepar, of a new platepar in SkyFit2,
; and the settings the Restore Defaults button of SkyFit2 sets.
; Distortion type, options: poly3+radial, poly3+radial3, poly3+radial5, radial3-all,
; radial4-all, radial5-all, radial3-odd, radial5-odd, radial7-odd, radial9-odd
platepar_distortion_type: radial7-odd
; Flags of the radial distortion types: equal aspect ratio of the axes, asymmetry
; correction, decentering correction (lenses whose elements are not centred on the
; optical axis), and the distortion centre fixed at the centre of the image
platepar_equal_aspect: true
platepar_asymmetry_corr: true
platepar_decentering_corr: false
platepar_force_distortion_centre: false

; Toggle downloading remote mask
mask_download_permissive: true

; Auto recalibration
; ------------------

; The limiting magnitude of the used stars, used for filtering out catalog
; stars which are fainter then the system can detect
catalog_mag_limit: 5.2

; How many calstars FF files to evaluate 
calstars_files_N: 400

; Minimum number of stars to use
calstars_min_stars: 1000

; A minimum number of stars on the image for accepting the image
min_matched_stars: 20

; Maximum number of stars to use for the fit on individual images
recalibration_max_stars: 200

; Minimum fraction of detected stars that the per-image recalibration fit
; must match to be accepted. Rejects sparse spurious fits (e.g. on cloudy
; nights) which would otherwise make the pointing drift away when chained
; from image to image
recalibration_min_match_fraction: 0.6

; Refine the pointing of the per-image recalibration by least squares on the
; matched stars. The search alone stops within its tolerance (about
; dist_check_threshold), which keeps a part of a pixel of the error of the
; platepar it started from
recalibration_lsq_refine: true

; If the average distance (pixels) between catalog and image stars is below
; this threshold, astrometry recalibration will not run but the existing
; calibration will be used
dist_check_threshold: 0.33

; If the average distance (pixels) is below this number, only a quick
; recalibration procedure will run
dist_check_quick_threshold: 0.4



[Thumbnails]

; Thumbnail binning
thumb_bin: 4

; How many images will be stacked per each thumbnail
thumb_stack: 5

; Number of thumbnails in each row
thumb_n_width: 10



[Stack]

; Whether to apply the mask to stack or not
stack_mask: false



[Timelapse]

; Automatically generate a timelapse using all FF files
timelapse_generate_captured: true

; Automatically generate a timelapse using all saved frame files
timelapse_generate_from_frames: true



[Colors]

; color palette to use for various charts -can be any matplotlib color scheme
; other options are gist_ncar, rainbow, gist_rainbow, inferno 
shower_color_map: gist_ncar

; color to use for plotting sporadics on the radiants map. Can be any matplotlib
; named color: https://matplotlib.org/stable/gallery/color/named_colors.html
; white stands out well but the default is gray. 
sporadic_color: gray



[MonitorProcessing]

; Settings for continuous processing of video files with RMS.MonitorProcessFrameInterface. See
; Guides/MonitorProcessing.md for the setup and how to run it

; Save the max pixel and average pixel images of every star extraction chunk as FF-equivalent PNG image pairs
; (FF_..._maxpixel.png and FF_..._avepixel.png). They are needed for the night reports (stacks, thumbnails,
; timelapse, calibration report)
monitor_save_images: true

; When to generate the night report:
;   sunrise  - after the end of the night (sunrise), once no new data of the night came in for the quiet time
;   idle     - whenever all data is processed and no new data came in for the quiet time
;   external - only when the file .report_now is created in the output directory
;   none     - never (python -m RMS.MonitorNightReport can still be run manually)
monitor_report_mode: sunrise

; Minutes without new processed files of the night before its report is generated (quiet time)
monitor_report_quiet_min: 15

; Time of day (UTC, HH:MM) of a partial report of the night, e.g. to have the products of the night in the
; morning while the processing is still catching up. It is made once per night, with the data processed until
; then, if the night was not reported yet. The final report follows when the processing of the night is done.
; Empty disables it
monitor_partial_report_time:

; Hours after the end of the night (sunrise) after which the files of the night which were not processed yet
; are skipped, so the processing of a night that can't be finished doesn't overflow into the following night.
; The night is then reported with the processed data. Skipped files are marked as done, delete their results
; directories to process them later. 0 disables it (all files are processed)
monitor_night_cutoff_hours: 0

; Upload the night archive (ArchivedFiles, following upload_mode) after the report. Also requires
; upload_enabled
monitor_upload: false

; Delete the image pairs of reported nights after this many days (0 keeps them), keeping the reports
monitor_delete_images_days: 0

; Delete old data from the output directory the same way RMS manages its data directory: old night
; directories in CapturedFiles and ArchivedFiles (capt_dirs_to_keep, arch_dirs_to_keep, quotas, and the free
; space needed for the next night), old archives (bz2_files_to_keep) and logs. Nights which were not reported
; yet are kept unless the space is needed
monitor_delete_old_data: true

; Save the most confident recalibrated platepar of each night (most matched stars, lowest residual) and use it
; for the following data. It is saved to the output directory as latest_<platepar name>, the given platepar is
; never overwritten, and a newer given platepar (e.g. fitted again manually) is used instead
monitor_update_platepar: true

; Calibrate the camera automatically. Without a platepar, the files are processed without the astrometry and
; the photometry until a platepar is fitted from the stars of a clear sky (and checked on other chunks of
; frames), then it is used for the following files and added to the detections of the night. A platepar which
; no longer fits the stars on a clear sky (e.g. the camera moved) is fitted again the same way. The fitted
; platepar is saved to the output directory as auto_<platepar name>, the given platepar is never overwritten.
; A platepar is judged on chunks of frames under a clear sky: the stars have to be matched and measured well in all
; parts of the image (rings around the centre and the sides), and the photometry has to fit everywhere. A new
; platepar is fitted from scratch on several chunks, which have to agree, and judged on other chunks. One which
; would replace the platepar has to be clearly better, and confirmed on a later file. A platepar which is far off
; is replaced right away on trial: the new one is kept if it passes on the following 15 minutes of clear sky, and
; the previous one is put back if it is clearly better there
monitor_auto_calibration: false

; Minutes of data between the attempts to fit a better platepar than the current one (one that fails is fitted
; again after 10 minutes)
monitor_auto_calibration_interval: 30

; Fit the vignetting coefficient also when a platepar exists (e.g. after changing the lens). Without a platepar it
; is always fitted, otherwise the coefficient of the platepar is kept
monitor_auto_calibration_fit_vignetting: false

; Only save the fitted platepars as candidates (auto_candidate_<platepar name>), to check them before they are used
monitor_auto_calibration_dry_run: false

; Save every calibrated detection as an ECSV file, with the results of each file. The night report collects
; them into the ECSV directory of the night
monitor_save_ecsv: false

; Continuous detection over the consecutive files of a recording: a file which follows the previous one
;   without missing frames is searched with the last chunks of frames of the previous file in front of it, and
;   an object which crosses the boundary is one detection, in the results of the file where it begins (only
;   with mf_replace_detection and without mf_buffer_memory)
monitor_continuous: false
; Number of chunks of frames of the previous file put in front
monitor_continuous_chunks: 1

; Additional night products, as at the end of a normal RMS night
; Single station shower association plots
monitor_shower_association: false
; FOV KML files (25, 70 and 100 km)
monitor_fov_kml: false
; Flux files
monitor_flux: false
; Observation summary (observation_summary.txt/json)
monitor_observation_summary: false

; Local directory to which every input file is copied before it is processed, and deleted from afterwards.
; Only use it when the input files are on a relatively slow network share (e.g. NFS over 1 Gb Ethernet): the
; processing reads every file twice (star extraction and meteor detection), so the copy halves the network
; traffic. It needs free space for one input file per worker. Empty disables it (the files are processed where
; they are)
monitor_staging_dir:

; Live status of the monitor for external monitoring: monitor_status.json in the output directory says whether
; the input is being recorded, whether the processing keeps up, the sky in the latest data and through the night,
; the health of the calibration, and any faults (see Guides/MonitorProcessing.md). It is rewritten every
; monitor_status_interval seconds and after every processed file
monitor_status: true
monitor_status_interval: 60

[MatchedFilter]

; Matched-filter detection of faint moving objects in frame-based video (RMS.MatchedFilterDetection). The
; frames are summed along a grid of velocities before thresholding, which finds objects well below the
; single-frame detection limit, and every detection is measured by fitting a moving PSF to short runs of frames.
; It can be run on files with: python -m RMS.MatchedFilterDetection

; Run the matched-filter detection on every file in the monitor, after the normal detection. The results are
; saved to the matched_filter directory of the results of every file, and the night report merges them into
; the matched_filter directory of the night
mf_enable: false

; With mf_enable, the matched filter replaces the normal detection in the monitor: its detections are the
; results of every file (FTPdetectinfo, night report, archive, upload), and the normal detection is not run.
; The stars are still extracted
mf_replace_detection: false

; Number of frames processed together (background, masks and search)
mf_block_frames: 256

; Detection threshold of the velocity search (sigma of the best velocity)
mf_threshold: 5.0

; Frames summed in the runs which are searched for the full range of speeds (longer runs find fainter fast
; objects, at a higher cost), and in a run for slow objects (0 disables)
mf_run_frames: 8, 16
mf_slow_run_frames: 32

; Search the full range of speeds (otherwise only slow objects are searched)
mf_velocity_search: true

; Speed range of the detected objects (deg/s)
mf_ang_vel_min: 0.01
mf_ang_vel_max: 2.0

; Minimum number of linked runs of a track
mf_min_hits: 3

; Minimum motion of a detection over its duration, in PSF widths (FWHM)
mf_min_displacement: 3.0

; Minimum duration of a detection (frames)
mf_min_frames: 20

; PSF sigma (px), 0 estimates it from the stars
mf_psf_sigma: 0

; Largest position error of a measurement (px). The measurements combine as few frames as possible (up to
; mf_max_measure_frames) to keep the position error below it
mf_max_pos_error: 0.5
mf_max_measure_frames: 8

; Minimum signal-to-noise ratio of the fitted amplitude of a measurement
mf_min_sample_snr: 3.0

; The position uncertainties of the fit are multiplied by this, to match the errors measured on objects added
; to real frames
mf_sigma_scale: 1.3

; Minimum number of measurements of a detection
mf_min_centroids: 6

; The positions of the measurements are combined over the measurements within +-this many frames (a local
; quadratic fit of the track), which reduces their errors 2 to 5 times. The positions of nearby measurements
; are then correlated. 0 disables it
mf_smooth_frames: 64

; Largest number of candidate tracks measured per file, or per segment of a file read in segments (the strongest
; ones), a safety limit of the processing time in bad conditions (e.g. thin clouds, very bright stars). The
; measurement of more candidates costs little, and the strength of a candidate tells little whether it is real
mf_max_tracks: 1000

; Largest gap (frames) between the hits of a track, e.g. between the flashes of a flashing object
mf_link_max_gap: 96

; Tiers of the velocity search. Fast objects are long in every frame and are searched on coarser bins, which costs
; much less (the number of velocities grows with the square of the speed in binned pixels) and loses a little
; sensitivity for the fast ones (~0.4 mag per doubling of the bin for a sharp PSF). A tier with the bin B searches
; the speeds up to mf_tier_speed*B px per frame, the faster speeds are searched on bins twice as large, up to
; mf_max_bin. 0 searches all speeds on 2x2 bins.
mf_tier_speed: 2.0
mf_max_bin: 8

; A fast object is a streak in every frame (it moves during the exposure). Sum the whole streak of every frame
; (several samples per frame along the motion) instead of only its middle: more sensitive to fast objects (up to
; ~0.5 mag together with finer tiers, e.g. mf_tier_speed 4), at the cost of several times more search time.
mf_streak_search: false

; Faint objects: the hits of the search down to this threshold (e.g. 3) are linked into chains along straight
; tracks over the whole file, and the chains whose signal summed along them is significant are measured like the
; other tracks. Finds objects which are below mf_threshold in most runs, at the cost of more processing time.
; 0 disables it
mf_faint_threshold: 0

; Largest number of faint chains measured per file, the most significant ones
mf_faint_max_tracks: 50

; Minimum combined significance of a detection: the PSF-weighted signal summed along its track over all
; frames, minus the same at times when the object is elsewhere (sigma)
mf_track_significance: 12.0

; A detection whose light is less concentrated at its centre than this, compared with the brightest axis through
; it (a thin linear structure, e.g. a trail, or light left along the path of a bright source which crossed the
; field), is rejected. 0 turns the test off
mf_line_concentration: 0.5

; Largest RMS distance of a detection across its direction of motion from one smooth path over its whole length
; (a quadratic in time, which follows the curvature of a real track): mf_track_deviation_fwhm PSF FWHMs (the
; scatter of the measurements) plus mf_track_deviation_length times the length of the track (the bending of a long
; track beyond the smooth path, e.g. by the distortion of a wide-field lens). Both are dimensionless, so they hold
; for cameras of other fields of view. A track which wanders sideways more is rejected. On recorded data, real
; tracks are below 0.75 FWHM (long ones below 0.6). mf_track_deviation_fwhm 0 turns the test off
mf_track_deviation_fwhm: 0.6
mf_track_deviation_length: 0.005

; Stars brighter than this in the median of the frames (in the noise of the sky in one frame) are masked
mf_star_threshold: 3.0

; The normalized frames are clipped to +/- this before the search (single frame outliers)
mf_clip: 10.0

; Moving sources brighter than this in a frame (in the noise of one pixel) leave faint trails along their row
; and column on some sensors; these rows and columns are left out of the search in that frame. 0 disables it
mf_trail_level: 25.0

; Pixels above the threshold in more than this fraction of all runs of the input are masked as static
mf_persistence: 0.2

; Margin from the image edge (px)
mf_edge_margin: 8

; Use the GPU for the velocity search: auto (if numba can use CUDA), on, off
mf_gpu: auto

; Clouded sky: the stars of every chunk of frames are matched to the catalog. Where they are fainter than on clear
; sky by more than mf_cloud_max_offset (mag), or reliably seen stars are missing, the sky is clouded: the clouded
; regions are not searched, and the measurements on clouded sky are removed, as their positions and magnitudes can't
; be trusted. It needs the stars and the platepar. The clear-sky brightness of every star is kept across the files
; of the camera, with a log of the conditions of every chunk, in its output directory (sky_reference_*.npz,
; sky_conditions_*.csv)
mf_cloud_filter: true
mf_cloud_max_offset: 0.15

; Smallest number of stars of the clearest chunk which have to match the catalog for the sky quality. With a
; calibration matching fewer, the clouded sky is not excluded (the file is processed without it, with a warning)
mf_cloud_min_matched: 30

; Saturation level of the raw frames (ADU). Saturated pixels are left out of the position fits and counted in
; the saturation column of the detections. 0 uses 98% of the range of the bit depth; set it for cameras which
; saturate below that
mf_saturation_level: 0

; Number of CPU threads (0 = all cores). With several monitor workers, use the number of cores divided by the
; number of workers, so they don't compete for the CPU
mf_threads: 0

; Memory for the frames read at once (GB per file being processed, i.e. per monitor worker). With it, a .vid file
; is read only once, in segments of as many frames as fit (e.g. 4 GB is about 4 minutes of 512x512 frames at 32
; fps), and every step takes the frames from memory. 0 reads the file for every step, as does a memory too
; small for 14 blocks of frames (1.75 GB for 512x512 frames), which the search of very slow objects needs
mf_buffer_memory: 0

; Memory for the normalized frames kept from the search for the measurement of the tracks (GB per file being
; processed). The blocks which fit are not read and normalized again (5 bytes per pixel and frame: a 30 s block of
; 1920x1080 frames at 15 fps needs 4.7 GB). 0 reads them again
mf_cache_memory: 0

; Frames which neighbouring segments share, so the objects crossing from one to the next are found in both and
; joined (a multiple of mf_block_frames, at most half a segment)
mf_segment_overlap: 512
